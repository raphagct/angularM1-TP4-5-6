# Copier vers .env puis renseigner les valeurs localement. Ne pas versionner .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/guitar-practice-cloud
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
FRONTEND_URL=http://localhost:4200

# Laisser vides pour désactiver Magic Link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ID client Web Google Identity Services. Laisser vide pour masquer la connexion Google.
GOOGLE_CLIENT_ID=
